    <!-- Privacy Policy Dialog -->
    <string name="privacy_title">गोपनीयता नीति</string>
    <string name="privacy_updated">अंतिम अद्यतन: 2026</string>
    <string name="privacy_sec1_title">1. शून्य व्यक्तिगत डेटा संग्रहण</string>
    <string name="privacy_sec1_desc">व्याज कैलकुलेटर आपकी पूर्ण गोपनीयता के प्रति प्रतिबद्ध है। हम कोई भी व्यक्तिगत डेटा, वित्तीय जानकारी या संपर्क विवरण एकत्र या साझा नहीं करते हैं।</string>
    <string name="privacy_sec2_title">2. 100% ऑफ़लाइन आर्किटेक्चर</string>
    <string name="privacy_sec2_desc">सभी गणना डेटा केवल आपके स्थानीय डिवाइस स्टोरेज पर सुरक्षित रहता है। आपके डिवाइस से कोई भी डेटा बाहर नहीं जाता।</string>
    <string name="privacy_sec3_title">3. कोई संवेदनशील अनुमति नहीं</string>
    <string name="privacy_sec3_desc">यह ऐप कैमरा, संपर्क, एसएमएस, स्टोरेज या लोकेशन जैसी कोई भी संवेदनशील अनुमति नहीं मांगता है।</string>
    <string name="privacy_sec4_title">4. पूर्ण उपयोगकर्ता नियंत्रण</string>
    <string name="privacy_sec4_desc">आप सेटिंग्स से कभी भी व्यक्तिगत गणनाओं को या संपूर्ण इतिहास को हटा सकते हैं।</string>

    <!-- Terms of Use Dialog -->
    <string name="terms_title">उपयोग की शर्तें</string>
    <string name="terms_sec1_title">1. केवल सूचनात्मक उद्देश्य</string>
    <string name="terms_sec1_desc">व्याज कैलकुलेटर एक गणितीय गणना उपकरण है। यह कोई औपचारिक कानूनी, वित्तीय या ऋण सलाह प्रदान नहीं करता है।</string>
    <string name="terms_sec2_title">2. गणना की सटीकता</string>
    <string name="terms_sec2_desc">गणनाएँ भारतीय पारंपरिक ब्याज प्रणाली के अनुसार सटीक रूप से की जाती हैं। ऋण लेन-देन के समय अपने औपचारिक नियमों की पुष्टि करें।</string>
    <string name="terms_sec3_title">3. लाइसेंस</string>
    <string name="terms_sec3_desc">व्यक्तिगत एवं व्यावसायिक उपयोग के लिए निःशुल्क प्रदान किया गया है।</string>

