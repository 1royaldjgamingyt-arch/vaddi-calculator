    <!-- Privacy Policy Dialog -->
    <string name="privacy_title">தனியுரிமைக் கொள்கை</string>
    <string name="privacy_updated">கடைசியாகப் புதுப்பிக்கப்பட்டது: 2026</string>
    <string name="privacy_sec1_title">1. பூஜ்ஜிய தனிப்பட்ட தரவு சேகரிப்பு</string>
    <string name="privacy_sec1_desc">வட்டி கால்குலேட்டர் உங்கள் தனியுரிமைக்கு முழு மதிப்பளிக்கிறது. எந்தவொரு தனிப்பட்ட விவரங்களையும் நாங்கள் சேகரிப்பதோ பகிர்வதோ இல்லை.</string>
    <string name="privacy_sec2_title">2. 100% ஆஃப்லைன் கட்டமைப்பு</string>
    <string name="privacy_sec2_desc">அனைத்துத் தரவுகளும் உங்கள் சொந்த சாதனத்தில் மட்டுமே பாதுகாப்பாக இருக்கும். சாதனத்தை விட்டு வெளியேறாது.</string>
    <string name="privacy_sec3_title">3. தேவையற்ற அனுமதிகள் இல்லை</string>
    <string name="privacy_sec3_desc">கேமரா, தொடர்புகள், SMS அல்லது இருப்பிடம் போன்ற எந்த அனுமதிகளையும் ஆப் கோருவதில்லை.</string>
    <string name="privacy_sec4_title">4. முழு பயனர் கட்டுப்பாடு</string>
    <string name="privacy_sec4_desc">அமைப்புகளில் இருந்து எப்போது வேண்டுமானாலும் கணக்கீட்டு வரலாற்றை நீங்கள் நீக்கலாம்.</string>

    <!-- Terms of Use Dialog -->
    <string name="terms_title">பயன்பாட்டு விதிமுறைகள்</string>
    <string name="terms_sec1_title">1. தகவல் நோக்கத்திற்கு மட்டுமே</string>
    <string name="terms_sec1_desc">வட்டி கால்குலேட்டர் ஒரு கணிதக் கணக்கீட்டுக் கருவியாகும். இது முறையான சட்ட அல்லது நிதி ஆலோசனை அல்ல.</string>
    <string name="terms_sec2_title">2. கணக்கீட்டு துல்லியம்</string>
    <string name="terms_sec2_desc">பாரம்பரிய இந்திய வட்டி முறைகளின்படி துல்லியமாக கணக்கிடப்படுகிறது. கடன் ஒப்பந்தத்தின் போது உங்கள் விதிமுறைகளை உறுதிப்படுத்திக் கொள்ளுங்கள்.</string>
    <string name="terms_sec3_title">3. உரிமம்</string>
    <string name="terms_sec3_desc">தனிப்பட்ட மற்றும் வணிகக் கணக்கீடுகளுக்கு இலவசமாகப் பயன்படுத்த அனுமதிக்கப்படுகிறது.</string>

