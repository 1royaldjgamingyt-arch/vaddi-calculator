    <!-- Privacy Policy Dialog -->
    <string name="privacy_title">Privacy Policy</string>
    <string name="privacy_updated">Last updated: 2026</string>
    <string name="privacy_sec1_title">1. Zero Personal Data Collection</string>
    <string name="privacy_sec1_desc">Vaddi Calculator is committed to total privacy. We do not collect, store, transmit, or sell any personal data, financial information, device identifiers, or contact details.</string>
    <string name="privacy_sec2_title">2. 100% Offline Architecture</string>
    <string name="privacy_sec2_desc">All calculation data and history are stored strictly on your local device storage using Android SQLite/Room database. No data ever leaves your device.</string>
    <string name="privacy_sec3_title">3. No Sensitive Permissions</string>
    <string name="privacy_sec3_desc">The application does not request camera, contacts, SMS, storage, audio, or location permissions. It runs safely with standard zero-permission sandboxing.</string>
    <string name="privacy_sec4_title">4. Complete User Control</string>
    <string name="privacy_sec4_desc">You can delete individual calculations or clear your entire calculation history at any time from the app settings.</string>

    <!-- Terms of Use Dialog -->
    <string name="terms_title">Terms of Use</string>
    <string name="terms_sec1_title">1. Informational Purpose Only</string>
    <string name="terms_sec1_desc">Vaddi Calculator is an arithmetic calculation utility for interest calculations based on user-entered values. It does not provide formal legal, tax, lending, or investment advice.</string>
    <string name="terms_sec2_title">2. Calculation Accuracy</string>
    <string name="terms_sec2_desc">Calculations follow standard simple interest mathematics and traditional Indian vaddi conventions. Users are advised to confirm formal loan terms with their counterparty or financial institution.</string>
    <string name="terms_sec3_title">3. License</string>
    <string name="terms_sec3_desc">Granted for personal and commercial interest computation under standard software terms without warranties of merchantability.</string>

