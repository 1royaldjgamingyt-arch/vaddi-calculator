<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft shadow under the V symbol -->
    <path
        android:pathData="M32,36 L54,80 L76,36 L67,36 L54,63 L41,36 Z"
        android:fillColor="#40000000" />

    <!-- Main Valli/Vaddi V Symbol with modern fintech gradient -->
    <path
        android:pathData="M31,34 L54,78 L77,34 L68,34 L54,61 L40,34 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="31"
                android:startY="34"
                android:endX="77"
                android:endY="78">
                <item android:offset="0.0" android:color="#FBBF24" />
                <item android:offset="0.5" android:color="#F59E0B" />
                <item android:offset="1.0" android:color="#10B981" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Rupee bar crossing through the V -->
    <path
        android:pathData="M26,40 L82,40 L82,45 L26,45 Z"
        android:fillColor="#FFFFFF" />

    <!-- Second Rupee bar crossing through the V -->
    <path
        android:pathData="M30,49 L78,49 L78,54 L30,54 Z"
        android:fillColor="#E2E8F0" />

    <!-- Small central currency spark indicator at apex -->
    <path
        android:pathData="M54,23 L56,28 L61,30 L56,32 L54,37 L52,32 L47,30 L52,28 Z"
        android:fillColor="#34D399" />
</vector>
